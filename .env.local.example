NEXT_PUBLIC_SUPABASE_URL=https://umloksyafcmjjcytrjgg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_PpGO2l00kMzx4zfnNEjbrw_-hfTXot-

# サーバー専用: 保護者紐付けで「メール → auth ユーザー ID」の検索と teacher_profiles の更新に使用。
# Supabase Dashboard → Project Settings → API → service_role（秘密鍵・流出禁止）
SUPABASE_SERVICE_ROLE_KEY=

# LINE Messaging API（欠席・振替・備考あり出席の管理者通知）
# LINE Developers → Messaging API チャネルのアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=
# 通知を受け取る管理者の LINE ユーザー ID（カンマ区切り。公式アカウントを友だち追加後に取得）
LINE_NOTIFY_USER_IDS=

# Wan Studio (/studio) — RunPod Serverless (Wan 2.2) + Script to Video
# RunPod Console → Settings → API Keys
RUNPOD_API_KEY=
# Serverless endpoint ID（例: abc123xyz）。Hub の Wan 2.2 エンドポイントでも可
RUNPOD_WAN_ENDPOINT_ID=
# RunPod 未設定時にデモ動画で UI 確認する（デフォルト有効。本番は false 推奨）
STUDIO_ALLOW_MOCK=true
# 任意: 脚本→シーン分割を LLM で行う（未設定ならルールベース分割）
OPENAI_API_KEY=
STUDIO_LLM_API_KEY=
STUDIO_LLM_BASE_URL=
STUDIO_LLM_MODEL=
